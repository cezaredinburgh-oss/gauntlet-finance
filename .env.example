# =============================================================================
# Gauntlet Finance — copy this file to ".env" and fill in your values
#   copy .env.example .env
# =============================================================================

APP_ENV=development
DEBUG=true

# -----------------------------------------------------------------------------
# Auth mode
#   dev      = no browser login; use service account for Google Sheets (RECOMMENDED)
#   oauth    = Google sign-in in the browser (optional; more setup)
#   disabled = no login checks
# -----------------------------------------------------------------------------
AUTH_MODE=dev

# Demo landing-page password login (isolated empty ledger — safe to share)
# One-click public demos (no email/password) — recommended for marketing hosts
# DEMO_TOUR_ENABLED=true
# DEMO_SANDBOX_ENABLED=true
# DEMO_SANDBOX_MAX_ACTIVE=50
# Legacy password demo (optional fallback form)
# DEMO_LOGIN_ENABLED=true
# DEMO_EMAIL=demo@gauntlet.local
# DEMO_PASSWORD=demo

# Owner password (real ledger). Prefer this over ALLOW_OPEN_AUTH on public hosts.
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=long-random-secret

# Multi-tenant (invite-only OAuth + per-user sheets) — see docs/MULTI_TENANT.md
# MULTI_TENANT=false
# PLATFORM_ADMIN_EMAILS=you@example.com
# Public hosts: ALLOW_OPEN_AUTH=false (never leave open access to your real sheet)


# Random long string for signing cookies (change this)
SECRET_KEY=change-me-to-a-long-random-string

# Session cookie names (gf_* avoids clash with Collective cf_*)
SESSION_COOKIE_NAME=gf_session

# React frontend origins (comma-separated)
# Default UI port is 5190 (not 5173/5180) to avoid clashing with other Vite apps
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190

# -----------------------------------------------------------------------------
# Google Sheet connection (service account — recommended for personal use)
# -----------------------------------------------------------------------------
# Spreadsheet ID from the browser URL:
#   https://docs.google.com/spreadsheets/d/  <SPREADSHEET_ID>  /edit
# You can paste the full URL; the app will extract the ID.
SPREADSHEET_ID=

# Path to the JSON key file downloaded from Google Cloud
# Default: secrets/service-account.json  (create the secrets/ folder)
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# Optional alternative: paste the entire JSON key on one line instead of a file
# GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Google OAuth (only if AUTH_MODE=oauth — NOT required for service account)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8020/api/auth/callback

# Optional: Railway cron POST /api/admin/jobs/tick with header X-Cron-Secret
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Domain / prices
# -----------------------------------------------------------------------------
HOLDING_PERIOD_EXEMPTION_DAYS=1095
PRIMARY_DISPLAY_CURRENCY=USD
SECONDARY_DISPLAY_CURRENCY=CZK
PRICE_CACHE_TTL_SECONDS=60
YFINANCE_ENABLED=true

# -----------------------------------------------------------------------------
# Grok / SpaceXAI (optional — transaction categorize assist)
# Server-side only. Never put XAI_API_KEY in the frontend.
# Testing: AI_ENABLED=true + key from https://console.x.ai
# -----------------------------------------------------------------------------
# AI_ENABLED=false
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.3
# AI_DAILY_TOKEN_CAP=200000
# AI_GLOBAL_DAILY_TOKEN_CAP=2000000
# AI_MAX_MERCHANTS_PER_REQUEST=40

# Bind: Start-App uses 127.0.0.1. Override host only if you accept LAN exposure.
API_HOST=127.0.0.1
# Default 8020 (not 8000/8010) so this API can run next to Collective / other backends
API_PORT=8020

# Optional: exit process if Sheets not configured (default false — API always starts)
# REQUIRE_SHEETS=false
